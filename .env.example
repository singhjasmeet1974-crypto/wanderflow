# ==========================================
# WANDERFLOW ENVIRONMENT CONFIGURATION
# ==========================================
# This project runs fully in Demo Evaluation Mode out of the box with realistic seed data
# and client-side persistence without requiring any external API keys.
#
# If connecting to an external production Supabase instance, supply the credentials below:

# 1. Supabase Backend (Optional)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Weather & Maps (Optional External Providers)
# Open-Meteo free live weather works automatically without API keys.
# If integrating OpenWeatherMap instead:
VITE_OPENWEATHER_API_KEY=

# If integrating Mapbox or Google Maps instead of OpenStreetMap / Leaflet:
VITE_MAPBOX_TOKEN=
